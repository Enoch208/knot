{
  "files": {
    "/etc/knot/database-client.env": {
      "mode": "0600",
      "keys": ["DATABASE_URL"]
    },
    "/etc/knot/api.env": {
      "mode": "0600",
      "keys": [
        "KNOT_API_AUTH_TOKEN",
        "KNOT_API_BUYER_ADDRESS",
        "KNOT_API_ALLOWED_ORIGIN"
      ]
    },
    "/etc/knot/artifact-client.env": {
      "mode": "0600",
      "keys": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "ARTIFACT_STORE_ENDPOINT",
        "ARTIFACT_STORE_BUCKET"
      ]
    },
    "/etc/knot/postgres.env": {
      "mode": "0600",
      "keys": ["POSTGRES_DB", "POSTGRES_USER", "POSTGRES_PASSWORD"]
    },
    "/etc/knot/object-store.env": {
      "mode": "0600",
      "keys": ["MINIO_ROOT_USER", "MINIO_ROOT_PASSWORD"]
    }
  },
  "constraints": {
    "ARTIFACT_STORE_ENDPOINT": "http://object-store:9000",
    "ARTIFACT_STORE_BUCKET": "knot-artifacts",
    "DATABASE_URL_HOST": "postgres"
  }
}
